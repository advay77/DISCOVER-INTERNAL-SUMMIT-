{
  "name": "discover-os",
  "version": "1.0.0",
  "private": true,
  "description": "DISCOVER Summit Command Center — internal operating system for the DISCOVER board, workstream leads and volunteers.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "use:sqlite": "node scripts/use-provider.mjs sqlite",
    "use:postgres": "node scripts/use-provider.mjs postgresql",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "prisma": "6.1.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
